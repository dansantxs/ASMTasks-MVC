# Ambiente de DESENVOLVIMENTO LOCAL (sua maquina).
# Copie para .env.dev e ajuste a senha. O .env.dev NAO vai pro git.
#
# Uso (subir SO o banco no Docker):
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml --env-file .env.dev up -d sqlserver

# Senha do usuario 'sa' do SQL Server.
# Regra do SQL Server: min. 8 caracteres, com maiuscula, minuscula e numero/simbolo.
DB_PASSWORD=Local_Dev_123!

# Nome do banco. Usado pelo backend quando rodado em Docker.
# No restore local (restore-local.ps1) o padrao tambem e ASMTasks.
DB_NAME=ASMTasks

# --- Abaixo so e necessario se voce for rodar backend/frontend TAMBEM em Docker ---
# (Para "so o banco no Docker" pode deixar como esta.)

# Chave JWT (min. 32 caracteres)
JWT_KEY=dev-chave-secreta-local-com-32-caracteres-min

CORS_ORIGINS=http://localhost:3000
JWT_SAMESITE=None
ASPNETCORE_ENVIRONMENT=Development
NEXT_PUBLIC_API_URL=http://localhost:5000/api
