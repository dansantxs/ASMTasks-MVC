DB_PASSWORD=TROQUE_POR_SENHA_FORTE
DB_NAME=ASMTasksProd
JWT_KEY=TROQUE_POR_CHAVE_SECRETA_MINIMO_32_CARACTERES
CORS_ORIGINS=https://app.seu-dominio.com
JWT_SAMESITE=Strict
ASPNETCORE_ENVIRONMENT=Production
NEXT_PUBLIC_API_URL=/api
CLOUDFLARE_TUNNEL_TOKEN=COLE_O_TOKEN_DO_TUNNEL_AQUI

# --- HTTPS na rede interna (Opção B — proxy Caddy: docker-compose.https.yml) ---
# Endereço pelo qual o sistema é acessado. Use o IP ou um nome interno do servidor.
# O CORS_ORIGINS acima deve apontar para o MESMO endereço (ex.: https://10.1.1.200).
SITE_ADDRESS=https://10.1.1.200
# Portas do proxy (padrão 80/443). Só mude se já houver algo usando essas portas.
PORT_HTTP=80
PORT_HTTPS=443
